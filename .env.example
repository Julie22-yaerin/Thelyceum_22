# OpenRouter API Keys — The Lyceum Agent Workforce
# Copy this file to .env and fill in your actual keys.
# Each domain has a dedicated API key for billing isolation & rate-limit tracking.
#
# VITE_ prefixed keys: used by Vite for client-side builds (legacy path).
# OPENROUTER_KEY_ prefixed keys: read server-side via process.env at POST /api/chat.
#   The proxy prefers the non-VITE_ keys first, falling back to VITE_ if unset.
#
# In production, you can set ONLY the OPENROUTER_KEY_* vars (omit VITE_ prefix)
# to keep keys out of the browser bundle entirely.

# Client-side (VITE embeds these in the browser bundle)
VITE_OPENROUTER_KEY_LAW=sk-or-v1-your-law-key-here
VITE_OPENROUTER_KEY_FINANCE=sk-or-v1-your-finance-key-here
VITE_OPENROUTER_KEY_TECH=sk-or-v1-your-tech-key-here

# Server-side only (never shipped to the browser — preferred)
OPENROUTER_KEY_LAW=sk-or-v1-your-law-key-here
OPENROUTER_KEY_FINANCE=sk-or-v1-your-finance-key-here
OPENROUTER_KEY_TECH=sk-or-v1-your-tech-key-here

# Lemon Squeezy — Settings > Webhooks (signing secret) and Settings > API (key)
# Server-side only. Used to verify webhook signatures and look up license keys.
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_API_KEY=

# Cal.com booking link shown on the Thank You / Waiting pages
VITE_CAL_LINK=nhu-y-pham-aliana-afiwbr/thelyceum.site
VITE_CAL_NAMESPACE=thelyceum.site

# Slack invite link (https://join.slack.com/t/...) shown on the Waiting page.
# Do NOT put a Slack OAuth/user token here — that grants live account access,
# not an invite. Leave empty to hide the Slack section.
VITE_SLACK_INVITE_URL=

# /admin page auth — required. Without it, GET /api/admin/orders always
# returns 401 (fails closed). Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_TOKEN=

# Live "beta slots claimed" counter on the landing page (optional overrides)
BETA_SLOT_BASELINE=84
BETA_SLOT_CAP=100

# ── Firestore — quota/task/report storage for the V1 API + MCP server ──────
# Firebase Console > Project Settings > Service Accounts > Generate new
# private key. Paste the JSON's fields below (never commit the JSON file).
# Server-side only; required for POST /api/v1/chat and POST /api/mcp to work
# — without it those return 503 rather than crashing.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the \n literal characters — this gets unescaped at runtime.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Supabase — used only by GET /api/notes (client/src/pages/Notes.tsx), a
# connectivity smoke test. If you used the Vercel↔Supabase integration,
# these are already set on Vercel; copy the same values here for local dev.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Salt used to fingerprint (not store) customers' upstream API keys passing
# through the zero-touch proxy. Required — without it the proxy refuses to
# hash and records "unsalted" instead of an attributable fingerprint.
LYCEUM_FINGERPRINT_SALT=TheLyceum_2enterprise
