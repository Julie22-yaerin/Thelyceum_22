{
  "$comment": "Per-department operating limits. Ships as the default; a workspace overrides it in the multi-agent setup screen.",
  "version": 1,
  "departments": {
    "dev_ops": {
      "budget": { "max_cents_per_session": 800, "max_tokens_per_minute": 200000, "max_calls_per_minute": 180 },
      "allowed_tools": ["read_*", "list_*", "get_*", "health_check", "restart_service"],
      "never_allowed": ["delete_database", "drop_*", "rotate_master_key"],
      "failover_chain": ["openai:gpt-4o", "anthropic:claude-sonnet-5", "openrouter:meta-llama/llama-3.3-70b-instruct"]
    },
    "finance": {
      "budget": { "max_cents_per_session": 500, "max_tokens_per_minute": 120000, "max_calls_per_minute": 120 },
      "allowed_tools": ["read_*", "list_*", "get_*", "calculate_*"],
      "never_allowed": ["issue_refund", "transfer_funds", "charge_card"],
      "failover_chain": ["anthropic:claude-sonnet-5", "openai:gpt-4o"]
    },
    "sales_outreach": {
      "budget": { "max_cents_per_session": 300, "max_tokens_per_minute": 80000, "max_calls_per_minute": 90 },
      "allowed_tools": ["read_*", "list_*", "get_*", "draft_*"],
      "never_allowed": ["send_email", "publish_*", "read_api_keys"],
      "failover_chain": ["openai:gpt-4o-mini", "openrouter:meta-llama/llama-3.3-70b-instruct"]
    },
    "qa_compliance": {
      "budget": { "max_cents_per_session": 400, "max_tokens_per_minute": 100000, "max_calls_per_minute": 120 },
      "allowed_tools": ["read_*", "list_*", "get_*", "validate_*", "audit_*"],
      "never_allowed": ["write_*", "publish_*", "delete_database"],
      "failover_chain": ["anthropic:claude-sonnet-5", "openai:gpt-4o"]
    }
  },
  "global_never_allowed": [
    "delete_database", "drop_*", "read_api_keys", "read_credentials",
    "export_all_customers", "rotate_master_key", "disable_audit_log", "disable_circuit_breaker"
  ],
  "failover": { "latency_ceiling_ms": 2000, "switch_budget_ms": 100 },
  "fact_guard": { "check_commitments": true, "retry_on_ungrounded": true }
}
