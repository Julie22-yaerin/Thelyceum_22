{
  "name": "the-lyceum",
  "version": "0.1.0",
  "private": true,
  "description": "The Lyceum \u2014 circuit breakers for AI. brake stops a dangerous action; redteam stops a one-sided conclusion.",
  "type": "module",
  "workspaces": [
    "packages/brake",
    "packages/redteam",
    "packages/thrift",
    "packages/server",
    "packages/site"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "server": "npm run dev --workspace @lyceum/server",
    "site": "npm run dev --workspace @lyceum/site",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "benchmark": "node scripts/benchmark.mjs",
    "post-news": "node scripts/post-news.mjs"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}