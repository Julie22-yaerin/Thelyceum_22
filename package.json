{
  "name": "the-lyceum",
  "version": "0.1.4",
  "private": false,
  "description": "The Lyceum — circuit breakers for AI. brake stops a dangerous action; redteam stops a one-sided conclusion; thrift stops the bill.",
  "type": "module",
  "bin": {
    "lyceum": "./scripts/lyceum.js",
    "brake": "./packages/brake/dist/cli.js",
    "redteam": "./packages/redteam/dist/cli.js",
    "thrift": "./packages/thrift/dist/cli.js"
  },
  "files": [
    "scripts",
    "packages/brake/dist",
    "packages/brake/package.json",
    "packages/redteam/dist",
    "packages/redteam/package.json",
    "packages/thrift/dist",
    "packages/thrift/package.json"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "workspaces": [
    "packages/brake",
    "packages/redteam",
    "packages/thrift",
    "packages/server"
  ],
  "scripts": {
    "build": "node scripts/build-all.mjs",
    "test": "npm run test --workspaces --if-present",
    "server": "npm run dev --workspace @lyceum/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "benchmark": "node scripts/benchmark.mjs",
    "package:beta": "node scripts/package-distribution.mjs --beta",
    "package:commercial": "node scripts/package-distribution.mjs --commercial",
    "package:all": "node scripts/package-distribution.mjs --all"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
