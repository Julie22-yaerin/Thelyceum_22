{
  "name": "brake",
  "version": "0.2.0",
  "description": "The emergency brake for AI agents, 1000ms SLA. CLI + MCP server + installable skill. The model pulls it itself when danger is detected \u2014 no slash required.",
  "type": "module",
  "bin": {
    "brake": "./dist/cli.js"
  },
  "main": "./dist/brake.js",
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "mcp:dev": "tsx src/mcp.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "keywords": [
    "mcp",
    "claude",
    "chatgpt",
    "ai-safety",
    "emergency-brake",
    "agent-control",
    "red-alert",
    "saas"
  ],
  "license": "MIT",
  "exports": {
    ".": "./dist/brake.js",
    "./danger": "./dist/danger.js",
    "./stop-all": "./dist/stop-all.js",
    "./audit": "./dist/audit.js",
    "./config": "./dist/config.js",
    "./license": "./dist/license.js"
  }
}