{
  "name": "redteam",
  "version": "1.0.0",
  "description": "The red team. An adversarial rebuttal layer for AI reasoning and code: scans claims, plans, and code edits for reasoning flaws, code drift, and crash risks, with intelligent context compacting. CLI + MCP server + installable skill.",
  "type": "module",
  "bin": {
    "redteam": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./challenge": "./dist/challenge.js",
    "./compact": "./dist/compact.js",
    "./code_scanner": "./dist/code_scanner.js",
    "./audit": "./dist/audit.js",
    "./config": "./dist/config.js",
    "./mode": "./dist/mode.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "mcp:dev": "tsx src/mcp.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "keywords": [
    "mcp",
    "claude",
    "chatgpt",
    "ai-safety",
    "red-team",
    "rebuttal",
    "devils-advocate",
    "reasoning",
    "debiasing",
    "adversarial",
    "compacting",
    "code-scanner"
  ],
  "license": "MIT"
}