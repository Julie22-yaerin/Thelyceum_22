{
  "name": "@lyceum/server",
  "version": "0.1.0",
  "private": true,
  "description": "The Lyceum license server: waitlist, subscriptions, license keys, gated setup guides, and the admin console.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/web','dist/web',{recursive:true})\"",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "bcryptjs": "^2.4.3",
    "brake": "*",
    "hono": "^4.6.0",
    "jsonwebtoken": "^9.0.2",
    "redteam": "*",
    "thrift": "*",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
